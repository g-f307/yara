// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(uuid())
  clerkId          String            @unique // Clerk's generated ID
  email            String            @unique
  name             String?
  projects         Project[]
  metadataVersions MetadataVersion[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model Project {
  id                      String                  @id @default(uuid())
  name                    String
  description             String?
  userId                  String
  user                    User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  files                   File[]
  sessions                AnalysisSession[]
  summaries               AnalysisSummary[]
  artifacts               Artifact[]
  artifactCompatibilities ArtifactCompatibility[]
  metadataVersions        MetadataVersion[]
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  @@index([userId])
}

model File {
  id        String    @id @default(uuid())
  name      String
  type      String // .qzv, .qza, .biom, .tsv
  url       String // Uploadthing URL
  key       String // Uploadthing Key (for deletion)
  size      Int
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  artifact  Artifact?
  createdAt DateTime  @default(now())

  @@index([projectId])
}

enum ArtifactStatus {
  VALID
  REJECTED
  FAILED
}

enum ArtifactKind {
  FEATURE_TABLE
  TAXONOMY
  METADATA
  PHYLOGENETIC_TREE
  ALPHA_VECTOR
  DISTANCE_MATRIX
  PCOA_ORDINATION
  RAREFACTION_CURVE
  UNKNOWN
}

enum CompatibilityStatus {
  COMPATIBLE
  INCOMPATIBLE
  AMBIGUOUS
  UNKNOWN
}

model Artifact {
  id                 String         @id @default(uuid())
  manifestArtifactId String         @unique
  projectId          String
  project            Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fileId             String?        @unique
  file               File?          @relation(fields: [fileId], references: [id], onDelete: SetNull)
  physicalName       String
  sha256             String
  size               Int
  extension          String
  status             ArtifactStatus
  kind               ArtifactKind
  semanticType       String?
  format             String?
  qiimeUuid          String?
  qiimeVersion       String?
  classifierVersion  String
  confidence         Float
  selected           Boolean        @default(false)
  metadataJson       Json
  classifiedAt       DateTime       @default(now())
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  sourceCompatibilities ArtifactCompatibility[] @relation("SourceArtifact")
  targetCompatibilities ArtifactCompatibility[] @relation("TargetArtifact")
  metadataVersions      MetadataVersion[]

  @@index([projectId, kind])
  @@index([projectId, selected])
}

enum MetadataSeverity {
  BLOCKING
  WARNING
  INFO
}

model MetadataVersion {
  id               String               @id @default(uuid())
  backendVersionId String               @unique
  projectId        String
  project          Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  artifactId       String
  artifact         Artifact             @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  parentVersionId  String?
  parentVersion    MetadataVersion?     @relation("MetadataVersionHistory", fields: [parentVersionId], references: [id], onDelete: SetNull)
  childVersions    MetadataVersion[]    @relation("MetadataVersionHistory")
  sha256           String
  schemaJson       Json
  source           String
  templateId       String
  templateVersion  String
  createdByUserId  String?
  createdByUser    User?                @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  active           Boolean              @default(false)
  validations      MetadataValidation[]
  createdAt        DateTime

  @@index([projectId, createdAt])
  @@index([projectId, active])
  @@index([artifactId])
}

model MetadataValidation {
  id                  String           @id @default(uuid())
  metadataVersionId   String
  metadataVersion     MetadataVersion  @relation(fields: [metadataVersionId], references: [id], onDelete: Cascade)
  rulesVersion        String
  severity            MetadataSeverity
  code                String
  columnName          String?
  affectedSamplesJson Json
  message             String
  suggestion          String
  createdAt           DateTime         @default(now())

  @@index([metadataVersionId, severity])
}

model MetadataTemplate {
  id          String                  @id
  name        String
  description String
  version     String
  fields      MetadataTemplateField[]
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
}

model MetadataTemplateField {
  id             String           @id @default(uuid())
  templateId     String
  template       MetadataTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name           String
  description    String
  dataType       String
  unit           String?
  requirement    String
  vocabularyJson Json
  position       Int

  @@unique([templateId, name])
  @@index([templateId, position])
}

model ArtifactCompatibility {
  id               String              @id @default(uuid())
  projectId        String
  project          Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceArtifactId String
  sourceArtifact   Artifact            @relation("SourceArtifact", fields: [sourceArtifactId], references: [id], onDelete: Cascade)
  targetArtifactId String
  targetArtifact   Artifact            @relation("TargetArtifact", fields: [targetArtifactId], references: [id], onDelete: Cascade)
  status           CompatibilityStatus
  reasonCode       String
  reasonMessage    String
  evidenceJson     Json?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@unique([sourceArtifactId, targetArtifactId, reasonCode])
  @@index([projectId, status])
}

model AnalysisSession {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages  Json // Chat history storing Vercel AI SDK CoreMessages
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

model AnalysisSummary {
  id         String   @id @default(uuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type       String // alpha, beta, taxonomy, rarefaction, statistics
  metric     String?
  groupCol   String?
  resultJson Json
  createdAt  DateTime @default(now())

  @@index([projectId])
}
