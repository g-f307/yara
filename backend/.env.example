DATABASE_URL=postgresql://user:password@host/yara_db
STORAGE_PATH=./uploads
MAX_FILE_SIZE_BYTES=134217728
ENVIRONMENT=development

# Allowlist separada por vírgulas. Wildcard apenas no início (*.dominio).
ALLOWED_STORAGE_HOSTS=utfs.io,ufs.sh,*.ufs.sh
MAX_DOWNLOAD_REDIRECTS=3
DOWNLOAD_CONNECT_TIMEOUT_SECONDS=5
DOWNLOAD_READ_TIMEOUT_SECONDS=30
MAX_ZIP_ENTRIES=2000
MAX_ZIP_UNCOMPRESSED_BYTES=536870912
MAX_ZIP_COMPRESSION_RATIO=100

# Deve ser idêntico ao valor configurado no frontend.
# Gere um valor local com: openssl rand -hex 32
YARA_INTERNAL_API_SECRET=
